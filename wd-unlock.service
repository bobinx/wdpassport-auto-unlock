[Unit]
Description=Western Digital My Passport Auto Unlock and Mount
Documentation=https://github.com/bobinx/wdpassport-auto-unlock
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wd-auto-unlock unlock
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
